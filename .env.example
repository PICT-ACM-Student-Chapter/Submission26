# ========================================================
# Pulzion 2026 - Production Environment Variables (.env)
# ========================================================
# Used by docker-compose.prod.yml on EC2

NODE_ENV=production
PORT=3001
PROJECT=pulzion-submission-backend

# --------------------------------------------------------
# PostgreSQL Configuration (Native Host on EC2)
# --------------------------------------------------------
# Because backend runs in Docker and Postgres runs on the EC2 host,
# use host.docker.internal (or 172.17.0.1) and port 5432.
DATABASE_URL=postgresql://postgres:<your_encoded_password>@host.docker.internal:5432/PulzionSubmission
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=PulzionSubmission
DB_USER=postgres
DB_PASSWORD=<your_password>
DATABASE_SSL=false

# --------------------------------------------------------
# JWT Authentication & EMS Integration
# --------------------------------------------------------
TOKEN_SECRET=<your_strong_jwt_secret>
TOKEN_EXPIRES_IN=1d

EMS_API=https://api.pulzion.pictacm.in

# --------------------------------------------------------
# AWS S3 Storage Config (ap-south-1)
# --------------------------------------------------------
AWS_ACCESS_KEY_ID=<your_aws_access_key_id>
AWS_SECRET_ACCESS_KEY=<your_aws_secret_access_key>
AWS_REGION=ap-south-1
AWS_S3_BUCKET=pulzion-submissions-bucket
