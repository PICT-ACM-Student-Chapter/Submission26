PORT=3001
PROJECT=pulzion-submission-backend
DATABASE_URL=postgresql://<db_user>:<db_password>@<db_host>/<db_name>?sslmode=require
NODE_ENV=dev
TOKEN_SECRET=<your_jwt_secret_token>
EMS_API=https://api.pulzion.pictacm.in

# AWS S3 Storage Config
AWS_ACCESS_KEY_ID=<your_aws_access_key_id>
AWS_SECRET_ACCESS_KEY=<your_aws_secret_access_key>
AWS_REGION=ap-south-1
AWS_S3_BUCKET=pulzion-submissions-bucket
