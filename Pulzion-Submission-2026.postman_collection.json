		{
			"name": "1-Auth & Profile",
			"description": "Sign in with EMS credentials. The script automatically saves {{token}} for all subsequent submission endpoints.",
			"item": [
				{
					"name": "POST User Signin (Auto-Saves {{token}})",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/user/signin",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"user",
								"signin"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{loginEmail}}\",\n  \"password\": \"{{loginPassword}}\"\n}"
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Signin 200 + token received\", function () {",
									"    pm.response.to.have.status(200);",
									"    var j = pm.response.json();",
									"    pm.expect(j.token).to.exist;",
									"    pm.collectionVariables.set(\"token\", j.token);",
									"    if (j.ems_token) pm.collectionVariables.set(\"ems_token\", j.ems_token);",
									"    console.log(\"Saved JWT token:\", j.token.substring(0, 15) + \"...\");",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "GET User Me (Current Profile)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/user/me",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
